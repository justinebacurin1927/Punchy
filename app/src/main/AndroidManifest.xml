<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.android.providers.downloads" />
        <package android:name="com.android.providers.downloads.ui" />
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/no_backup"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Punchy">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".AlignmentActivity" android:exported="false" />
        <activity android:name=".DetectionActivity" android:exported="false" />
        <activity android:name=".DownloadPanelActivity" android:exported="false"
            android:theme="@style/Theme.Punchy.Popup" android:excludeFromRecents="true"
            android:noHistory="true" android:taskAffinity="" />
        <service
            android:name=".DownloadListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <service
            android:name=".RingService"
            android:label="@string/overlay_service_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ring_accessibility" />
        </service>
        <service
            android:name=".PunchyTile"
            android:label="@string/app_name"
            android:icon="@drawable/ic_punchy"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
